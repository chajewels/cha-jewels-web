# Copy to .env.e2e.local (gitignored) for `npm run e2e:signup`. Never commit the real file.
# The Hub's Supabase project — the one the storefront signs in against.
E2E_SUPABASE_URL=
# Service-role key for that project. Full database access: keep it local only.
E2E_SUPABASE_SERVICE_ROLE_KEY=
# Optional. The deployment to test; defaults to https://www.chajewelsjp.com
E2E_BASE_URL=
