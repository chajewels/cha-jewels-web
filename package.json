{
  "name": "cha-jewels-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:terms": "node scripts/check-terminology.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:i18n": "node --experimental-strip-types --no-warnings --import ./tests/register-aliases.mjs scripts/gen-i18n-sections.mjs --check && node scripts/check-i18n.mjs && npm run -s check:layaway-ja",
    "gen:i18n": "node --experimental-strip-types --no-warnings --import ./tests/register-aliases.mjs scripts/gen-i18n-sections.mjs",
    "check:analytics": "node scripts/check-analytics.mjs",
    "check:money": "node scripts/check-money.mjs",
    "check:cutouts": "node scripts/check-cutouts.mjs",
    "check:lastmod": "node scripts/gen-page-lastmod.mjs --check",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:fonts": "node scripts/check-font-urls.mjs",
    "prebuild": "npm run -s gen:i18n && node scripts/check-placeholders.mjs",
    "postbuild": "node scripts/check-font-urls.mjs",
    "check:layaway-ja": "node --experimental-strip-types --no-warnings --import ./tests/register-aliases.mjs scripts/check-layaway-ja.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings --import ./tests/register-aliases.mjs --test \"tests/**/*.test.mjs\"",
    "e2e:signup": "playwright test --config e2e/playwright.config.ts",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > lib/supabase/database.types.ts",
    "check:jp-font": "node scripts/check-jp-font-live.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.1",
    "@react-spring/web": "10.0.3",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "1.3.23",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "spring-text-engine": "0.1.5",
    "tailwind-merge": "^2.5.5",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.17",
    "zod": "^4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.186.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.4.49",
    "postcss-import": "16.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  }
}
