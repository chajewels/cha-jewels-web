# Shared Supabase project — the SAME project as Cha Jewels Hub ERP. Never create a second one.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_PROJECT_ID=
# Used only by server actions / route handlers. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Revalidation secret: the Hub calls /api/revalidate with this when stock or price changes.
REVALIDATE_SECRET=
NEXT_PUBLIC_SITE_URL=https://www.chajewelsjapan.com
# Payments (Phase 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMONGO_SECRET_KEY=

# Local preview without Supabase (fixture data). Never set in production.
NEXT_PUBLIC_PREVIEW_FIXTURES=0
