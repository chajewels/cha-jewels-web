# ---- Hub API (Lovable-owned edge functions). This is the website's ONLY backend connection. ----
# Base URL of the Hub's functions, e.g. https://<project>.supabase.co/functions/v1/website
HUB_API_URL=
# Server-side key issued by the Hub. Never NEXT_PUBLIC_.
HUB_API_KEY=
# Shared secret the Hub sends on POST /api/revalidate
REVALIDATE_SECRET=

NEXT_PUBLIC_SITE_URL=https://www.chajewelsjapan.com
# Local preview without the Hub (fixture data). Never set in production.
NEXT_PUBLIC_PREVIEW_FIXTURES=0

# ---- Phase 2 (customer auth + payments). Supabase Auth client keys come from the Hub's public config. ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
